# ─────────────────────────────────────────────────────────────
#  Secretos de los bots (copia este archivo como .env y complétalo).
#  .env está en .gitignore: NUNCA se sube a GitHub.
# ─────────────────────────────────────────────────────────────

# Bot GENERAL (run_general.py: tecnología, moda, juguetes, electro, frescos…)
TELEGRAM_TOKEN=TU_TOKEN_DEL_BOT_GENERAL
CHAT_ID=TU_CHAT_ID_GENERAL

# Bot CANASTA BÁSICA (run_alimentos.py: abarrotes, lácteos, desayuno, aseo y limpieza)
TELEGRAM_TOKEN3=TU_TOKEN_DEL_BOT_CANASTA
CHAT_ID3=TU_CHAT_ID_CANASTA

# Bot 4 · OFERTAS BOMBA (opcional): recibe además, con foto, toda alerta de cualquiera de los dos
# bots con descuento > 69 % (desde -70 %). Si se deja vacío, los bots siguen igual sin reenviar.
TELEGRAM_TOKEN4=TU_TOKEN_DEL_BOT_4
CHAT_ID4=TU_CHAT_ID_BOT_4

# Opcional: otro chat para el bot general (si se deja vacío, usa TELEGRAM_TOKEN / CHAT_ID).
# TELEGRAM_TOKEN_GENERAL=
# CHAT_ID_GENERAL=

# Opcional: monitor externo (healthchecks.io, gratis). Crea un check por bot con periodo 5 min y
# gracia 10 min, y pega aquí su URL de ping. Si el VPS se cae o el bot deja de correr, te avisa.
# HEALTHCHECK_URL_ALIMENTOS=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# HEALTHCHECK_URL_GENERAL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
